# ==============================================================================
# BRAIN OS - GITIGNORE CONFIGURATION
# Production-grade protection for proprietary assets, secrets, and build artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROPRIETARY DIGITAL ASSETS & COMMERCIAL PRODUCTS (DO NOT PUBLISH / SELLABLE DATA)
# ------------------------------------------------------------------------------
# Strictly protect Brain OS Vault archives, customer deliverables, and digital products
storage/protected/*
!storage/protected/.gitkeep
!storage/protected/README.md
storage/uploads/*
storage/temp/*
*.zip
*.tar.gz
*.tar
*.rar
*.7z
*.iso
*.dmg
*.pkg

# Databases, local stores & backups
*.sqlite
*.sqlite3
*.db
*.bak
*.dump
*.sql

# ------------------------------------------------------------------------------
# 2. ENVIRONMENT VARIABLES & SECRETS
# ------------------------------------------------------------------------------
# Never commit credentials, private keys, or API tokens
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
# Allow public template
!.env.example

# ------------------------------------------------------------------------------
# 3. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 4. BUILD & RUNTIME OUTPUTS
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.vercel/
.turbo/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. OPERATING SYSTEM & SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 6. IDE & EDITOR SETTINGS
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. LOGS & DIAGNOSTICS
# ------------------------------------------------------------------------------
logs/
*.log
