# ==============================================================================
# BRAIN OS ENVIRONMENT CONFIGURATION (Template)
# Copy this file to .env.local and add your real credentials.
# NEVER commit .env.local to GitHub or public source control!
# ==============================================================================

# Application URL (Used for generating absolute callback links & metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Payment Gateway (Razorpay)
# Obtain these from: https://dashboard.razorpay.com/#/access/api-keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret_optional"
# Optional Hosted Payment Page URL (e.g. https://pages.razorpay.com/brainos)
NEXT_PUBLIC_RAZORPAY_PAYMENT_PAGE_URL=""


# Cryptographic Token Security (HMAC-SHA256 Token Minting)
# Minimum 32-character high-entropy secret string
AUTH_SECRET="replace_with_a_secure_random_32_plus_character_secret_string"
DOWNLOAD_TOKEN_SECRET="replace_with_another_secure_random_32_plus_character_secret_string"

# Storage Settings
# Driver can be 'local' or customized for cloud storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/protected"
